# Solana mainnet RPC. Public endpoint is heavily rate-limited; swap in a
# private endpoint (Helius/QuickNode/Triton) before running anything hot.
RPC_URL=https://api.mainnet-beta.solana.com

# Only needed for the PDA dust test (scripts/verify_wrappers.ts --dust).
# Never point this at an authority or guardian key.
DUST_KEYPAIR_PATH=
