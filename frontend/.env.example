# Solana RPC. Public endpoint is heavily rate-limited; set a private one.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Pyth Hermes. Price routes have required a key since the 2026-08-26 Core upgrade.
# Sign up: https://pythdata.app/signup
#
# NOTE: entitlements are per-feed, not per-class. A key can be entitled to
# Metal.XAU and still 403 on Equity.US.SPY and on Crypto.PAXG/USD. Check the
# plan covers every feed in config/wrappers.ts before relying on it.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

# Solana devnet RPC, read by /api/devnet and so by every page. The public endpoint
# rate-limits hard enough that the page will intermittently show a read error;
# set a private one for anything that has to look reliable.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
